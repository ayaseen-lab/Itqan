# AI chat assistant (optional). The app runs without this; chat is simply disabled.
# Get a FREE key (no billing/credit card) from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-2.0-flash).
# GEMINI_MODEL=gemini-2.0-flash

# Optional: official Quran.Foundation Content API (server-side only).
# If unset, the app uses the free public api.quran.com endpoints automatically.
# Get credentials at https://api-docs.quran.foundation
# QF_ENV=production            # or "prelive"
# QF_CLIENT_ID=
# QF_CLIENT_SECRET=
