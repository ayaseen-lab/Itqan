# Supabase (required for accounts, family, and competitions)
# Project: https://supabase.com/dashboard/project/fjwvivjkuboopijjusuu
NEXT_PUBLIC_SUPABASE_URL=https://fjwvivjkuboopijjusuu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Optional: direct Postgres (server tools / migrations only — never expose to the browser)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.fjwvivjkuboopijjusuu.supabase.co:5432/postgres

# WabilHuda includes a built-in knowledge engine — no key needed for basic answers.
# Production domain: https://wabilhuda.com

# Optional: Google Search Console site verification token
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-token
GROQ_API_KEY=

# Optional: override Groq model (defaults to llama-3.3-70b-versatile).
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: official Quran.Foundation Content API (server-side only).
# If unset, the app uses the free public api.quran.com endpoints automatically.
# Get credentials at https://api-docs.quran.foundation
# QF_ENV=production            # or "prelive"
# QF_CLIENT_ID=
# QF_CLIENT_SECRET=
